{
    "name": "lrc-maker",
    "version": "6.3.6",
    "description": "SHINOBIWAN LRC Maker — éditeur et synchroniseur LRC moderne pour paroles horodatées.",
    "repository": "https://github.com/shinobione/lrc-maker.git",
    "author": "magic-akari <akari.ccino@gmail.com>",
    "license": "MIT",
    "keywords": [
        "lrc",
        "lrc maker",
        "lyric",
        "lyric maker",
        "shinobiwan"
    ],
    "bugs": "https://github.com/shinobione/lrc-maker/issues",
    "homepage": "https://shinobione.github.io/lrc-maker/",
    "files": [
        "src",
        "build"
    ],
    "packageManager": "pnpm@10.11.0",
    "type": "module",
    "scripts": {
        "start": "vite",
        "build": "vite build && vite build --config vite.embed.config.ts && node scripts/test-embed-bundle.mjs",
        "fix:fmt": "dprint fmt",
        "check:fmt": "dprint check",
        "check:lint": "oxlint src -D correctness",
        "check:studio": "node scripts/test-studio-context.mjs",
        "check:reducer": "node scripts/test-lrc-reducer.mjs"
    },
    "imports": {
        "#const/*": "./src/const/*"
    },
    "dependencies": {
        "@lrc-maker/lrc-parser": "^0.1.17",
        "@wavesurfer/react": "^1.0.11",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "wavesurfer.js": "^7.9.5"
    },
    "devDependencies": {
        "@swc/core": "^1.11.29",
        "@types/node": "^22.15.21",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "core-js": "^3.42.0",
        "dprint": "^0.50.0",
        "gen_dep_tag": "^0.0.3",
        "lightningcss": "1.32.0",
        "oxlint": "^0.16.11",
        "rollup-plugin-externals": "^0.0.1",
        "rollup-plugin-swc3": "^0.12.1",
        "toggle-switch-css": "^1.0.3",
        "typescript": "^5.8.3",
        "vite": "^6.3.5"
    }
}
